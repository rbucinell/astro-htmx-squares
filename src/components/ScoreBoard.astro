---
import type { IFootballEvent } from "@models/events";
import ScoreCard from "./ScoreCard.astro";
import { getWinners } from "@lib/scores";
import { GET as GetPicks } from '@api/picks/index.ts';

interface Props {
  event: IFootballEvent
}

let { event } = Astro.props;

Astro.url.searchParams.append('event', event._id.toString() || '');
const picks = (await (await GetPicks(Astro)).json()) || [];
const purchased = picks?.filter( p => p.paid).length;
let currentPayouts = event.squares.payouts.map( (payout:number) => (payout * ( purchased * event.squares.price )) );
let winners = getWinners( event );
---
<div class="container min-w-[500px] flex flex-row flex-auto max-w-[900px] justify-items-center">
  { currentPayouts.map( (payout,i) =>  {
    return <ScoreCard q={i+1} payout={payout} afc={event.afc.scores[i]} nfc={event.nfc.scores[i]} winner={picks.find( p => winners[i] === p?.pick )} />
  })}
</div>