---
import DefaultLayout from "@layouts/DefaultLayout.astro";
import QuarterScoreForm from "@components/QuarterScoreForm.astro";
import { GET as GetPicks } from '../pages/api/picks/index.ts';
import { GET as GetEvents } from '../pages/api/events/index.ts';

const events = (await (await GetEvents()).json()) || [];
const selectedEventId = Astro.url.searchParams.get('eventId') || events[0]?._id.toString();
const selectedEvent = events.find(e => e._id.toString() === selectedEventId) || events[0];

Astro.url.searchParams.append('event', selectedEvent._id.toString() || '');
const picks = (await (await GetPicks(Astro)).json()) || [];
let scores = [];
---
<DefaultLayout title="Manage">
      <main class="w-full px-10"></main>
        <div class="mb-4 flex flex-row gap-2">
            <label for="event-select" class="block text-sm font-medium my-auto mb-2">
                Select Event:
            </label>
            <select 
                id="event-select" 
                class="px-4 py-2 border rounded-md"
                onchange="window.location.href = '?eventId=' + this.value"
            >
                {events.map(event => (
                <option  value={event._id.toString()} selected={event._id.toString() === selectedEventId}>
                    {event.name} - {event.season}
                </option>
                ))}
            </select>
        </div>
  

        <div class="grid grid-cols-2 md:grid-cols-4 gap-2 md:gap-4 p-2">
            {[1,2,3,4].map(q => {
                return <QuarterScoreForm quarter={q} event={selectedEvent} />
            })}
        </div>


        <ul class="m-1 mx-auto p-1">
            { picks.map( pick => {

                return <li id={pick.pick} class="border m-1 p-2 flex justify-between">

                    <div class="flex items-start p-1 gap-3 w-full">
                        <div class="border border-black p-1 px-2 bg-gray-300 self-center rounded">{pick.pick}</div>
                        <div class="flex flex-col justify-evenly">
                            <div>{pick.display}</div>
                            <div>{pick.email}</div>
                        </div>
                    </div>
                    <div class="flex justify-end flex-grow gap-4 items-start p-1">
                        { (!pick.paid || pick.paid === 'false') &&
                            <button type="button"
                                hx-put={`api/picks/${pick.pick}?eventId=${selectedEvent._id}&paid=true`}
                                hx-swap="outerHTML"
                                class ="px-3 border border-green-800 bg-green-200 hover:bg-green-600 rounded-md">
                                <span>$</span>
                            </button>
                        }
                        
                        <button type="button"
                            hx-confirm={`Are you sure you want to delete ${pick.pick}?`}
                            hx-target={`#${pick.pick}`}  
                            hx-swap="outerHTML" 
                            hx-delete={`api/picks/${pick.pick}?eventId=${selectedEvent._id}`} 
                            class="px-3 border border-red-800 bg-red-200 hover:bg-red-600 rounded-md">X
                        </button>                    
                </div>
                </li>

            })}
        </ul>
    </main>
</DefaultLayout>